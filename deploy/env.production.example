# Salin jadi file bernama ".env" di ~/pltdpoka/.env (di server, JANGAN di-commit).
# Isi bagian yang bertanda <...>.

APP_NAME="PLN Monitor ULPLTD POKA"
APP_ENV=production
# Buat di PC:  php artisan key:generate --show
APP_KEY=<base64:...>
APP_DEBUG=false
APP_URL=https://pltdpoka.my.id
APP_TIMEZONE=Asia/Jayapura

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=single
LOG_LEVEL=error

# Nama database & user di cPanel biasanya berawalan nama akun, mis. feby7274_pltdpoka
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<cpanel_database>
DB_USERNAME=<cpanel_user>
DB_PASSWORD=<password_user_db>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
# Tidak ada queue worker di shared hosting; aplikasi ini tidak memakai job/queue.
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log
