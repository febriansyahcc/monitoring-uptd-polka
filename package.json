{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "docs:sync": "node scripts/build-docs.mjs",
        "docs:dev": "node scripts/build-docs.mjs && vitepress dev docs-src",
        "docs:build": "node scripts/build-docs.mjs && vitepress build docs-src",
        "manual:pdf": "node scripts/build-manual-pdf.mjs",
        "manual:screenshots": "node scripts/capture-manual-screenshots.mjs"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "puppeteer-core": "^24.43.1",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7",
        "vitepress": "^1.6.4"
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.6.1",
        "@lucide/vue": "^1.28.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "apexcharts": "^6.7.0",
        "lucide-vue-next": "^1.0.0",
        "vue": "^3.5.40",
        "vue3-apexcharts": "^1.11.1"
    }
